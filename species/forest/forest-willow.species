# White willow (Salix alba) of stream banks: the CWA willow (tree_str_vrba) at 16 m, a broad
# drooping crown from a third of the height. Base species: solstice-cwa-vrba.
height 16
trunk radius=0.30 flare=0.35 gnarl=0.06
crown round
bark willow_bark
level per_metre=3 span=0.3..0.97 angle=60..40 length=0.42 taper=0.3 radius=0.5 upturn=0 droop=0.35 gnarl=0.3 whorl=0
level per_metre=3.5 span=0.2..0.97 angle=45..45 length=0.42 taper=0.3 radius=0.6 upturn=0 droop=0.55 gnarl=0.3 whorl=0
level per_metre=8 span=0.2..1 angle=30..30 length=0.3 taper=0.3 radius=0.6 upturn=0 droop=0.65 gnarl=0.4 whorl=0
terminal on
leaves willow_leaves per_metre=46 length=0.06..0.12 width=0.17 variants=0.5,0.3,0.15,0.05 normals=0.5 lean=1.7
