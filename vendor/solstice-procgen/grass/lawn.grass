# A mown lawn: short, fine blades standing close together and mostly upright, thick enough
# to hide the soil.
size 1
tufts per_m2=400 blades=6..12 height=0.05..0.085 width=0.0035..0.0055 lean=0.05..0.45
undergrowth per_m2=3000 height=0.03..0.06
variants 0.5,0.35,0.15,0
dry 0.03
colors 0.055,0.115,0.02 0.08,0.135,0.024 0.045,0.1,0.034 0.2,0.17,0.08
# Clover and daisies, low enough to survive the mower.
weed kind=clover per_m2=15 leaves=5..10 length=0.008..0.013 width=0.9 stalk=0.025..0.05 flowers=0.25 flower_height=0.05..0.08 flower_size=0.007 leaf=0.035,0.08,0.03 flower=0.55,0.5,0.48
weed kind=rosette per_m2=4 leaves=6..10 length=0.02..0.04 width=0.5 flowers=0.6 flower_height=0.04..0.08 flower_size=0.009 leaf=0.04,0.085,0.02 flower=0.7,0.7,0.65 centre=0.6,0.42,0.02
