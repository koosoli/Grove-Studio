# Grass at the end of a dry summer: straw-coloured, half of it dead, in loose leaning tufts.
size 2
tufts per_m2=35 blades=10..24 height=0.3..0.7 width=0.004..0.008 lean=0.2..0.9
undergrowth per_m2=300 height=0.04..0.12
